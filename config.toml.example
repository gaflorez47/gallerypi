[gallery]
media_dir = "/home/pi/Pictures"
grid_columns = 4        # 3–6
thumbnail_size = 256    # pixels, square

[performance]
thumb_gen_threads = 2   # 2 on RPi 4, 4 on desktop
thumb_cache_entries = 150
scan_on_startup = true
viewer_preload_count = 1  # images to preload ahead/behind in viewer (0 = off; each ~50 MB RAM)

[ui]
fullscreen = true

[video]
# "auto": try h264_v4l2m2m hardware decoder, fall back to SW if unavailable
# "none": always use software decode
hw_accel = "auto"
default_volume = 80     # 0–100
loop_videos = true
