export component ViewerScreen {
    in property <image> viewer-image;
    in property <bool> loading;
    callback close();
    callback swipe-left();
    callback swipe-right();

    private property <float> scale: 1.0;
    private property <length> offset-x: 0px;
    private property <length> offset-y: 0px;
    private property <length> drag-start-x;
    private property <length> drag-start-y;
    private property <length> drag-start-offset-x;
    private property <length> drag-start-offset-y;
    private property <length> swipe-start-x;
    private property <duration> swipe-start-time;
    private property <float> swipe-dx-px;
    private property <float> swipe-velocity;
    private property <bool> is-dragging: false;

    Rectangle {
        background: black;
        width: parent.width;
        height: parent.height;

        Image {
            source: viewer-image;
            width: parent.width * scale;
            height: parent.height * scale;
            x: (parent.width - self.width) / 2 + offset-x;
            y: (parent.height - self.height) / 2 + offset-y;
            image-fit: contain;
            opacity: loading ? 0.0 : 1.0;
            animate opacity { duration: loading ? 0ms : 300ms; }
        }

        if loading: Rectangle {
            background: #00000088;
            Text {
                text: "Loading…";
                color: white;
                font-size: 18px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    is-dragging = true;
                    swipe-start-x = self.mouse-x;
                    swipe-start-time = animation-tick();
                    drag-start-x = self.mouse-x;
                    drag-start-y = self.mouse-y;
                    drag-start-offset-x = offset-x;
                    drag-start-offset-y = offset-y;
                } else if e.kind == PointerEventKind.up {
                    is-dragging = false;
                    swipe-dx-px = (self.mouse-x - swipe-start-x) / 1px;
                    swipe-velocity = abs(swipe-dx-px) / max(1.0, (animation-tick() - swipe-start-time) / 1ms);
                    offset-x = 0px;
                    offset-y = 0px;
                    if scale <= 1.05 {
                        if swipe-dx-px > parent.width / 1px * 0.1 || (swipe-dx-px > parent.width / 1px * 0.03 && swipe-velocity > 0.5) {
                            swipe-right();
                        } else if -swipe-dx-px > parent.width / 1px * 0.1 || (-swipe-dx-px > parent.width / 1px * 0.03 && swipe-velocity > 0.5) {
                            swipe-left();
                        }
                    }
                }
            }
            moved => {
                if is-dragging {
                    if scale > 1.05 {
                        offset-x = drag-start-offset-x + (self.mouse-x - drag-start-x);
                        offset-y = drag-start-offset-y + (self.mouse-y - drag-start-y);
                    } else {
                        // rubber-band follow while swiping
                        offset-x = (self.mouse-x - swipe-start-x) * 0.4;
                    }
                }
            }
            scroll-event(e) => {
                // delta-y is length; divide by 1px to get a dimensionless float
                scale = max(1.0, min(8.0, scale * (1.0 + (e.delta-y / 1px) * 0.002)));
                if scale <= 1.0 {
                    offset-x = 0px;
                    offset-y = 0px;
                }
                EventResult.accept
            }
        }

        // Close button (top-right)
        Rectangle {
            x: parent.width - 76px;
            y: 12px;
            width: 64px;
            height: 64px;
            background: #1a2a4add;
            border-radius: 32px;
            drop-shadow-blur: 8px;
            drop-shadow-color: #000000aa;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: 2px;
            TouchArea {
                clicked => {
                    scale = 1.0;
                    offset-x = 0px;
                    offset-y = 0px;
                    close();
                }
            }
            Text {
                text: "✕";
                color: white;
                font-size: 28px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
