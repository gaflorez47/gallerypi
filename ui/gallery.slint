import { ListView } from "std-widgets.slint";
import { MonthEntry, GalleryRowData, ThumbnailData } from "types.slint";
import { MonthScroller } from "month_scroller.slint";
import { ThumbnailCell } from "thumbnail_cell.slint";

component MonthHeaderRow {
    in property <string> label;

    HorizontalLayout {
        padding-left: 16px;
        alignment: start;
        Text {
            text: label;
            color: #aaaaaa;
            font-size: 24px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component ImageRow {
    in property <[ThumbnailData]> items;
    in property <int> item-count;
    in property <length> cell-size;

    callback tapped(int);
    callback touch-down(float);
    callback touch-move(float);
    callback touch-up(float);

    height: cell-size + 4px;
    HorizontalLayout {
        alignment: start;
        spacing: 2px;
        padding: 2px;
        for item[i] in items: ThumbnailCell {
            visible: i < item-count;
            item-id: item.item-id;
            thumb-image: item.thumb-image;
            thumb-ready: item.thumb-ready;
            media-type: item.media-type;
            size: cell-size;
            tapped(id)      => { root.tapped(id); }
            touch-down(y)   => { root.touch-down(y); }
            touch-move(y)   => { root.touch-move(y); }
            touch-up(y)     => { root.touch-up(y); }
        }
    }
}

component GalleryRowDelegate {
    in property <GalleryRowData> row-data;
    in property <int> n-cols;
    in property <length> thumb-size;

    callback tapped(int);
    callback touch-down(float);
    callback touch-move(float);
    callback touch-up(float);

    // Fill available width evenly, capped at thumb-size
    private property <length> cell-size: min(
        thumb-size,
        (self.width - 4px - max(0, n-cols - 1) * 2px) / max(1, n-cols)
    );
    height: row-data.is-header ? 48px : (cell-size + 4px);

    // Background TouchArea: lowest z — handles drag for header rows and cell gaps.
    // Cell TouchAreas (higher z) capture events in their own areas first.
    TouchArea {
        width: root.width;
        height: root.height;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.touch-down(self.mouse-y / 1px);
            } else if e.kind == PointerEventKind.up {
                root.touch-up(self.mouse-y / 1px);
            }
        }
        moved => {
            root.touch-move(self.mouse-y / 1px);
        }
    }

    if row-data.is-header: MonthHeaderRow {
        width: root.width;
        label: row-data.header-label;
    }
    if !row-data.is-header: ImageRow {
        items: row-data.items;
        item-count: row-data.item-count;
        cell-size: cell-size;
        tapped(id)      => { root.tapped(id); }
        touch-down(y)   => { root.touch-down(y); }
        touch-move(y)   => { root.touch-move(y); }
        touch-up(y)     => { root.touch-up(y); }
    }
}

export component GalleryScreen {
    in property <[GalleryRowData]> gallery-rows;
    in property <[MonthEntry]> month-entries;
    in-out property <int> grid-columns: 4;
    in-out property <length> thumb-size: 256px;
    // Set to row index >= 0 to trigger an instant scroll (no animation)
    in property <int> scroll-to-row: -1;

    in property <bool> force-show-scroller: false;

    callback cell-tapped(int);   // item-id
    callback jump-to-month(int, int);
    callback reminisce-tapped();

    // Read by Rust: scroll position, visible area height, and list view width.
    out property <float> scroll-offset: -list-view.viewport-y / 1px;
    out property <float> viewport-height: list-view.height / 1px;
    out property <float> list-view-width: list-view.width / 1px;

    // Dynamic row height based on actual list-view width (matches GalleryRowDelegate formula).
    private property <length> row-height: min(
        thumb-size,
        (list-view.width - 4px - max(0, grid-columns - 1) * 2px) / max(1, grid-columns)
    ) + 4px;

    // Computed minimum viewport-y (maximum scroll position)
    private property <length> min-viewport-y: -(gallery-rows.length * row-height - list-view.height);

    // Fling / momentum state
    private property <float> fling-velocity: 0;   // px per 16ms tick
    private property <bool>  fling-active: false;
    private property <float> velocity-ema: 0;     // rolling velocity estimate (px/event)

    // Drag / scroll tracking (owned here; rows fire callbacks to update)
    private property <float> ts-start-y: 0;
    private property <float> ts-start-vp: 0;
    private property <bool>  ts-scrolling: false;
    private property <float> ts-last-y: 0;

    Timer {
        interval: 16ms;
        running: fling-active;
        triggered => {
            if list-view.viewport-y > 0px {
                // Overscrolled top — spring back
                root.fling-velocity = root.fling-velocity * 0.80
                    - (list-view.viewport-y / 1px) * 0.15;
            } else if list-view.viewport-y < root.min-viewport-y {
                // Overscrolled bottom — spring back
                root.fling-velocity = root.fling-velocity * 0.80
                    - ((list-view.viewport-y - root.min-viewport-y) / 1px) * 0.15;
            } else {
                root.fling-velocity = root.fling-velocity * 0.94;
            }
            list-view.viewport-y = list-view.viewport-y + root.fling-velocity * 1px;
            root.scroll-tick-counter = root.scroll-tick-counter + 1;
            if abs(root.fling-velocity) < 0.5
               && list-view.viewport-y <= 0px
               && list-view.viewport-y >= root.min-viewport-y {
                root.fling-active = false;
                root.fling-velocity = 0;
            }
        }
    }

    // Fast-scroller state
    private property <int> scroll-tick-counter: 0;
    private property <float> scroller-fraction:
        scroll-offset / max(1.0, gallery-rows.length * (row-height / 1px) - list-view.height / 1px);

    changed scroll-offset => {
        scroll-tick-counter = scroll-tick-counter + 1;
    }

    // Scroll instantly when scroll-to-row changes (no animation)
    changed scroll-to-row => {
        if scroll-to-row >= 0 {
            list-view.viewport-y = -(scroll-to-row * row-height);
        }
    }

    VerticalLayout {
        // Toolbar
        Rectangle {
            height: 52px;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                alignment: end;
                Rectangle {
                    background: #3a5a8a;
                    border-radius: 6px;
                    width: 120px;
                    height: 36px;
                    TouchArea {
                        clicked => { reminisce-tapped(); }
                    }
                    Text {
                        text: "Reminisce";
                        color: white;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Main content: gallery list + floating month scroller overlay
        Rectangle {
            // Gallery list view (full width)
            list-view := ListView {
                for row in gallery-rows: GalleryRowDelegate {
                    row-data: row;
                    n-cols: root.grid-columns;
                    thumb-size: root.thumb-size;

                    tapped(id) => { root.cell-tapped(id); }

                    touch-down(y) => {
                        root.ts-start-y   = y;
                        root.ts-start-vp  = list-view.viewport-y / 1px;
                        root.ts-last-y    = y;
                        root.ts-scrolling = false;
                        root.fling-active  = false;
                        root.fling-velocity = 0;
                        root.velocity-ema   = 0;
                    }

                    touch-move(y) => {
                        if abs(y - root.ts-start-y) > 8 {
                            root.ts-scrolling = true;
                        }
                        if root.ts-scrolling {
                            let raw-y = (root.ts-start-vp + y - root.ts-start-y) * 1px;
                            if raw-y > 0px {
                                list-view.viewport-y = raw-y * 0.4;
                            } else if raw-y < root.min-viewport-y {
                                list-view.viewport-y = root.min-viewport-y + (raw-y - root.min-viewport-y) * 0.4;
                            } else {
                                list-view.viewport-y = raw-y;
                            }
                            root.velocity-ema = root.velocity-ema * 0.6 + (y - root.ts-last-y) * 0.4;
                            root.ts-last-y = y;
                            root.scroll-tick-counter = root.scroll-tick-counter + 1;
                        }
                    }

                    touch-up(y) => {
                        if root.ts-scrolling {
                            if abs(root.velocity-ema) > 0.5
                               || list-view.viewport-y > 0px
                               || list-view.viewport-y < root.min-viewport-y {
                                root.fling-velocity = root.velocity-ema;
                                root.fling-active = true;
                            }
                        }
                    }
                }
            }

            // Month fast scroller (floating overlay on right edge)
            MonthScroller {
                x: parent.width - self.width;
                y: 0px;
                height: parent.height;
                month-entries: root.month-entries;
                scroll-fraction: scroller-fraction;
                scroll-tick: scroll-tick-counter;
                force-show: root.force-show-scroller;
                jump-to-month(y, m) => { root.jump-to-month(y, m); }
            }
        }
    }
}
