export component VideoPlayer {
    in property <image> video-frame;
    in-out property <float> position;
    in property <float> duration;
    in-out property <float> volume;
    in property <bool> playing;
    callback close();
    callback play-pause();
    callback seek(float);
    callback volume-changed(float);

    private property <bool> controls-visible: true;

    Rectangle {
        background: black;
        width: parent.width;
        height: parent.height;

        // Video frame
        Image {
            source: video-frame;
            width: parent.width;
            height: parent.height;
            image-fit: contain;
        }

        // Tap to toggle controls
        TouchArea {
            clicked => {
                controls-visible = !controls-visible;
            }
        }

        // Close button (top-right, always visible)
        Rectangle {
            x: parent.width - 68px;
            y: 12px;
            width: 56px;
            height: 56px;
            background: close-ta.has-hover ? #444444cc : #222222cc;
            border-radius: 28px;
            drop-shadow-blur: 8px;
            drop-shadow-color: #000000aa;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: 2px;
            close-ta := TouchArea {
                clicked => { close(); }
            }
            Text {
                text: "✕";
                color: white;
                font-size: 20px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Controls overlay (bottom bar)
        if controls-visible: Rectangle {
            y: parent.height - 120px;
            height: 120px;
            width: parent.width;
            background: @linear-gradient(180deg, #00000000, #000000dd);

            VerticalLayout {
                padding: 12px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;

                // Seek bar row
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: Math.floor(position / 60) + ":" + (Math.floor(Math.mod(position, 60)) < 10 ? "0" : "") + Math.floor(Math.mod(position, 60));
                        color: white;
                        font-size: 13px;
                        vertical-alignment: center;
                        min-width: 44px;
                    }
                    // Seek track (tall touch area, slim visual)
                    Rectangle {
                        height: 24px;
                        background: transparent;
                        // Visual track
                        Rectangle {
                            x: 0px;
                            y: (parent.height - 4px) / 2;
                            width: parent.width;
                            height: 4px;
                            background: #555555;
                            border-radius: 2px;
                            // Progress fill
                            Rectangle {
                                x: 0px;
                                y: 0px;
                                width: duration > 0 ? parent.width * (position / duration) : 0px;
                                height: parent.height;
                                background: #5588cc;
                                border-radius: 2px;
                            }
                        }
                        // Thumb
                        Rectangle {
                            x: (duration > 0 ? parent.width * (position / duration) : 0px) - (seek-ta.has-hover ? 12px : 10px);
                            y: (parent.height - (seek-ta.has-hover ? 24px : 20px)) / 2;
                            width: seek-ta.has-hover ? 24px : 20px;
                            height: seek-ta.has-hover ? 24px : 20px;
                            background: seek-ta.has-hover ? #e0e0e0 : white;
                            border-radius: seek-ta.has-hover ? 12px : 10px;
                            drop-shadow-blur: 4px;
                            drop-shadow-color: #00000088;
                            drop-shadow-offset-x: 0px;
                            drop-shadow-offset-y: 1px;
                        }
                        seek-ta := TouchArea {
                            clicked => {
                                seek(self.mouse-x / self.width * duration);
                            }
                            moved => {
                                seek(self.mouse-x / self.width * duration);
                            }
                        }
                    }
                    Text {
                        text: Math.floor(duration / 60) + ":" + (Math.floor(Math.mod(duration, 60)) < 10 ? "0" : "") + Math.floor(Math.mod(duration, 60));
                        color: #888888;
                        font-size: 13px;
                        vertical-alignment: center;
                        min-width: 44px;
                    }
                }

                // Buttons row
                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    // Play/Pause
                    Rectangle {
                        width: 56px;
                        height: 44px;
                        background: play-ta.has-hover ? #4a4a4a : #333333;
                        border-radius: 8px;
                        play-ta := TouchArea {
                            clicked => { play-pause(); }
                        }
                        Text {
                            text: playing ? "▮▮" : "▶";
                            color: white;
                            font-size: 18px;
                            width: parent.width;
                            height: parent.height;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "Vol";
                        color: #aaaaaa;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    // Volume bar — no fixed height so HorizontalLayout stretches it to 44px
                    Rectangle {
                        width: 120px;
                        background: transparent;
                        // Visual track
                        Rectangle {
                            x: 0px;
                            y: (parent.height - 4px) / 2;
                            width: parent.width;
                            height: 4px;
                            background: #555555;
                            border-radius: 2px;
                            // Volume fill
                            Rectangle {
                                x: 0px;
                                y: 0px;
                                width: parent.width * volume;
                                height: parent.height;
                                background: #888888;
                                border-radius: 2px;
                            }
                        }
                        // Thumb
                        Rectangle {
                            x: parent.width * volume - (vol-ta.has-hover ? 10px : 8px);
                            y: (parent.height - (vol-ta.has-hover ? 20px : 16px)) / 2;
                            width: vol-ta.has-hover ? 20px : 16px;
                            height: vol-ta.has-hover ? 20px : 16px;
                            background: vol-ta.has-hover ? #e8e8e8 : #cccccc;
                            border-radius: vol-ta.has-hover ? 10px : 8px;
                        }
                        vol-ta := TouchArea {
                            clicked => {
                                volume-changed(self.mouse-x < 0px ? 0.0 : self.mouse-x > self.width ? 1.0 : (self.mouse-x / self.width));
                            }
                            moved => {
                                volume-changed(self.mouse-x < 0px ? 0.0 : self.mouse-x > self.width ? 1.0 : (self.mouse-x / self.width));
                            }
                        }
                    }
                }
            }
        }
    }
}
