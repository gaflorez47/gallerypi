export component ThumbnailCell {
    in property <int> item-id;
    in property <image> thumb-image;
    in property <bool> thumb-ready;
    in property <string> media-type;
    in property <length> size: 256px;

    callback tapped(int);        // item-id — fires on release if no drag occurred
    callback touch-down(float);  // raw viewport-relative touch y
    callback touch-move(float);  // raw viewport-relative touch y
    callback touch-up(float);    // raw viewport-relative touch y

    private property <float> td-start-y: 0;
    private property <bool>  td-dragging: false;

    width: size;
    height: size;

    Rectangle {
        background: #222222;
        border-radius: 2px;

        if thumb-ready: Image {
            source: thumb-image;
            width: size;
            height: size;
            image-fit: cover;
        }

        if !thumb-ready: Rectangle {
            background: #2a2a2a;
            // Placeholder shimmer
        }

        // Video indicator overlay
        if media-type == "video": Rectangle {
            x: size - 28px;
            y: size - 28px;
            width: 24px;
            height: 24px;
            background: #00000088;
            border-radius: 12px;
            Text {
                text: "▶";
                color: white;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.td-start-y  = self.mouse-y / 1px;
                root.td-dragging = false;
                root.touch-down(self.mouse-y / 1px);
            } else if e.kind == PointerEventKind.up {
                if !root.td-dragging {
                    root.tapped(root.item-id);
                }
                root.touch-up(self.mouse-y / 1px);
            }
        }
        moved => {
            if abs(self.mouse-y / 1px - root.td-start-y) > 8 {
                root.td-dragging = true;
            }
            root.touch-move(self.mouse-y / 1px);
        }
    }
}
